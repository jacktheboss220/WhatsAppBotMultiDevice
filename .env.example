# ============================================================================
# WhatsApp bot - environment template
#   cp .env.example .env     then fill in the values. NEVER commit .env.
# [required] = bot won't work / won't start without it
# [optional] = feature is skipped or has a default when blank
# ============================================================================

# ── Identity / permissions ──────────────────────────────────────────────────
# [required] Owner number(s) in the form "<phone>,<lid>" - country code, digits only, no "+".
#   phone = your normal WhatsApp number; lid = your WhatsApp LID (send the `jid` command to the bot to see both).
#   Example: 919876543210,123456789012345
MY_NUMBER=
# [required] The number the bot runs on, same "<phone>,<lid>" form.
BOT_NUMBER=
# [optional] Moderators: comma-separated phone numbers (digits, "+" and spaces are ignored).
#   Example: 919811111111,919822222222
MODERATORS=
# [required] Command prefix, e.g. - or ! or .
PREFIX=-

# ── Database ────────────────────────────────────────────────────────────────
# [required] MongoDB connection string. Stores the WhatsApp session, groups, members and stats.
#   Example: mongodb+srv://user:pass@cluster.mongodb.net/
MONGODB_KEY=

# ── Web server / admin dashboard ────────────────────────────────────────────
# [optional] HTTP port. Default 8000 locally; Docker/Koyeb examples use 8080.
PORT=8000
# [optional] Public URL of the app, no trailing slash. Needed for Google login (OAuth callback is
#   <HOST_URL>/auth/google/callback). Default http://localhost:8000
HOST_URL=http://localhost:8000
# [required] Signs login sessions. App exits if missing. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# [optional] Dashboard password login. If blank, password login is disabled (Google login only).
ADMIN_PASSWORD=
# [optional] Google OAuth for the dashboard (console.cloud.google.com > Credentials > OAuth client).
#   Add <HOST_URL>/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google emails allowed to sign in. Example: me@gmail.com,friend@gmail.com
GOOGLE_ALLOWED_EMAILS=
# [optional] Extra browser origins allowed to call the API (comma-separated, e.g. https://my-site.com).
#   Leave empty: the dashboard and QR page are same-origin and need no CORS.
CORS_ORIGINS=

# ── AI (Eva) ────────────────────────────────────────────────────────────────
# [optional] Gemini API key for the `eva` command (aistudio.google.com/apikey). Eva is disabled if blank.
GOOGLE_API_KEY=

# ── Search / media APIs ─────────────────────────────────────────────────────
# [optional] Google Custom Search (`img`, `search`). A separate key from the Gemini one above.
GOOGLE_API_KEY_SEARCH=
# Programmable Search Engine ID (programmablesearchengine.google.com)
SEARCH_ENGINE_KEY=
# [optional] remove.bg key for `removebg` (remove.bg/api)
REMOVE_BG_KEY=
# [optional] Genius token for `lyric` (genius.com/api-clients)
GENIUS_ACCESS_SECRET=
# [optional] X/Twitter bearer token for the `twitter` command (developer.x.com)
TWITTER_BEARER_TOKEN=
# [optional] Instagram session cookie for `idp` (profile pictures). Copy the Cookie header from a logged-in browser.
INSTAGRAM_COOKIE=

# ── Media tools ─────────────────────────────────────────────────────────────
# [optional] yt-dlp binary. Docker sets /usr/local/bin/yt-dlp; leave blank locally to use the bundled one.
YTDLP_PATH=
# [optional] PATH to a Netscape-format cookies.txt exported from a logged-in browser. If blank, cookies
#   saved in the database (set from the dashboard) are used instead.
#   Fixes YouTube "Sign in to confirm you're not a bot" / age-restricted errors on servers.
YTDLP_COOKIES=
# [optional] ffmpeg binary. Blank = bundled ffmpeg-static. Docker sets "ffmpeg".
FFMPEG_PATH=

# ── Redis cache (optional) ──────────────────────────────────────────────────
# Caches group metadata and user devices across restarts. Used automatically when REDIS_URL or
# REDIS_HOST is set; otherwise the bot uses in-memory caches. Set USE_REDIS=false to force memory-only.
USE_REDIS=
# Option A - URL (recommended, e.g. Upstash). TLS is auto-detected from rediss://
#   Example: rediss://default:password@host:6379
REDIS_URL=
# Option B - individual fields (redis.io cloud or self-hosted)
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
# Set true for TLS with Option B
REDIS_TLS=false

# ── Notifications (optional) ────────────────────────────────────────────────
# Telegram log alerts: create a bot with @BotFather, then get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Auto-forward videos posted in one GROUP to another chat (WhatsApp JIDs, e.g. 1203630...@g.us).
#   Both must be set; forwarding is off when FROM is blank.
VIDEO_FORWARD_FROM_JID=
VIDEO_FORWARD_TO_JID=

# ── Danger zone ─────────────────────────────────────────────────────────────
# Owner-only remote eval (`test` / `code` command) = full server access. Leave unset in production.
ENABLE_EVAL=
